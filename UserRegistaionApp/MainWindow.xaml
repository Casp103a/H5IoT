<Window x:Class="UserRegistaionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UserRegistaionApp"
        mc:Ignorable="d"
        Title="User Registration"
        Height="650"
        Width="400"
        Background="#F7F8FA"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,16"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#888" BlurRadius="6" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern Label Style -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <Path x:Name="CheckMark"
                                      Data="M 4 10 L 9 15 L 16 6"
                                      Stroke="#2563EB"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A3A3A3"/>
                                <Setter TargetName="CheckMark" Property="Stroke" Value="#A3A3A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="White" CornerRadius="12" Padding="32" Margin="40">
            <StackPanel>
                <TextBlock Text="Register New User"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           Margin="0,0,0,24"
                           HorizontalAlignment="Center"
                           Height="35"/>
                <Label Content="Username"/>
                <TextBox Name="UsernameTextBox" Height="35"/>
                <Label Content="Scan card before registering"
                       FontSize="16"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
                <Label Content="Pin"/>
                <PasswordBox Name="PinPasswordBox" Height="35" PreviewTextInput="PinTextBox_PreviewTextInput" DataObject.Pasting="PinTextBox_Pasting"  VerticalContentAlignment="Center"/>
                <Label Content="Confirm Pin"/>
                <PasswordBox Name="ConfirmationPinPasswordBox" Height="35" PreviewTextInput="PinTextBox_PreviewTextInput" DataObject.Pasting="PinTextBox_Pasting" VerticalContentAlignment="Center"/>
                <CheckBox Name="ExpireCheckBox" Content="Use expire date"></CheckBox>
                <DatePicker Name="ExpireDatePicker"
                            Margin="0,4,0,16"
                            Height="35"
                            FontSize="16"
                            SelectedDateFormat="Short"/>
                <Button Content="Register"
                        Click="Button_Click"
                        HorizontalAlignment="Stretch" Height="40"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
